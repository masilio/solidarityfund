DATABASE_URL=postgresql://sf_user:sf_pass@localhost:5432/solidarity_fund
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@fund.local
ADMIN_PASSWORD=ChangeMe123!

# Flutterwave v4 sandbox — get free test credentials at https://dashboard.flutterwave.com
# (toggle "Test Mode" on, then Settings -> API Keys): a Client ID and Client Secret, used
# via OAuth2 to get a bearer token (v4's auth scheme). Leave blank to disable live gateway
# calls; the rest of the payment workflow (instructions popup, manual reference entry)
# still works without them.
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_IDP_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token
FLUTTERWAVE_BASE_URL=https://developersandbox-api.flutterwave.com
FLUTTERWAVE_WEBHOOK_HASH=
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Shown to contributors as where to send a bank transfer or MoMo payment.
FUND_BANK_ACCOUNT=00000010
FUND_MOMO_AIRTEL=25073000010
FUND_MOMO_MTN=25078000010
